<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap mp">

  <Identity
    Name="3c5ec9d5-1924-435f-a87f-53af32b31392"
    Publisher="CN=Jake"
    Version="1.0.0.0" />

  <mp:PhoneIdentity PhoneProductId="3c5ec9d5-1924-435f-a87f-53af32b31392" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>rtlSdrAppUWP</DisplayName>
    <PublisherDisplayName>Jake</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.0.0" MaxVersionTested="10.0.0.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="rtlSdrAppUWP.App">
      <uap:VisualElements
        DisplayName="rtlSdrAppUWP"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="rtlSdrAppUWP"
        BackgroundColor="transparent">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"/>
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />   
    
    <DeviceCapability Name="usb">

      <Device Id="vidpid:0bda 2832">
        <Function Type="classId:ff * *"/>
      </Device>
    
      <Device Id="vidpid:0bda 2838">
        <Function Type="classId:ff * *"/>
      </Device>
    
    </DeviceCapability>
  </Capabilities>
</Package>